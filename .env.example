DATABASE_URL=postgresql://northstar:northstar@localhost:55432/northstar
TEST_DATABASE_URL=postgresql://northstar:northstar@localhost:55432/postgres

# Docker compose
# Keep DEMO_NOW=now. The API reads the real clock (capacity window, insurance validity,
# 90-day lane history), so a pinned past timestamp makes the demo data look stale.
# To refresh demo data, reseed: docker compose run --rm -e FORCE_RESEED=1 init
DEMO_NOW=now
# Must equal the `iss` of tokens you mint (the README examples use this value).
JWT_ISSUER=http://mock-idp:9000
# Host port overrides are edited in docker-compose.yml (postgres 55432, redis 56379)
